    "import matplotlib.pyplot as plt\n",
    "from sklearn.metrics import roc_curve, roc_auc_score, confusion_matrix\n",
    "\n",
    "# Ground truth\n",
    "# If already binary 0/1, use: y_true_bin = df[\"y_true\"].astype(int)\n",
    "y_true_bin = (df[\"y_true\"] >= 0.5).astype(int)\n",
    "\n",
    "# Scores to compare\n",
    "score_prev = df[\"y_prev\"].astype(float)\n",
    "score_pred = df[\"y_pred\"].astype(float)\n",
    "score_triv = df[\"y_pred\"].astype(float) * 0 + 1\n",
    "\n",
    "# ROC + AUC\n",
    "fpr_prev, tpr_prev, _ = roc_curve(y_true_bin, score_prev)\n",
    "fpr_pred, tpr_pred, _ = roc_curve(y_true_bin, score_pred)\n",
    "fpr_triv, tpr_triv, _ = roc_curve(y_true_bin, score_triv)\n",
    "\n",
    "auc_prev = roc_auc_score(y_true_bin, score_prev)\n",
    "auc_pred = roc_auc_score(y_true_bin, score_pred)\n",
    "auc_triv = roc_auc_score(y_true_bin, score_triv)\n",
    "\n",
    "# Operating points at threshold 0.5\n",
    "thr = 0.5\n",
    "hat_prev = (score_prev >= thr).astype(int)\n",
    "hat_pred = (score_pred >= thr).astype(int)\n",
    "hat_triv = (score_triv >=thr).astype(int)\n",
    "\n",
    "tn0, fp0, fn0, tp0 = confusion_matrix(y_true_bin, hat_prev).ravel()\n",
    "tn1, fp1, fn1, tp1 = confusion_matrix(y_true_bin, hat_pred).ravel()\n",
    "tn2, fp2, fn2, tp2 = confusion_matrix(y_true_bin, hat_triv).ravel()\n",
    "\n",
    "tpr_prev_05 = tp0 / (tp0 + fn0)\n",
    "fpr_prev_05 = fp0 / (fp0 + tn0)\n",
    "\n",
    "tpr_pred_05 = tp1 / (tp1 + fn1)\n",
    "fpr_pred_05 = fp1 / (fp1 + tn1)\n",
    "\n",
    "tpr_pred_05 = tp1 / (tp1 + fn1)\n",
    "fpr_pred_05 = fp1 / (fp1 + tn1)\n",
    "\n",
    "tpr_triv_05 = tp2 / (tp2 + fn2)\n",
    